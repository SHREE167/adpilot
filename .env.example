# Optional. Without any of these, AdPilot still returns a full plan
# using the trained XGBoost scorer + copy templates.

GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant

OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

GOOGLE_GENERATIVE_AI_API_KEY=
# GOOGLE_MODEL=gemini-2.0-flash

# Optional. Without this, plans live in server memory + browser localStorage.
# JSON files are not used: they do not persist on Vercel serverless.
POSTGRES_URL=

# v2 enrichment. Set to 1 to make every data source read
# fixtures/api/<source>/*.json instead of calling live APIs (offline demo/tests).
# Local/dev only: fixture files are not bundled into Vercel functions.
ADPILOT_MOCK_APIS=

# F1 part B: PageSpeed Insights v5 (mobile speed, checked after the plan renders).
# Google Cloud > enable "PageSpeed Insights API" > API key restricted to that API.
PAGESPEED_API_KEY=
