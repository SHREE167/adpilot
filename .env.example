# Optional. Without any of these, AdPilot still returns a full plan
# using the trained XGBoost scorer + copy templates.

# LLM wording (English only): Groq first, Gemini if Groq fails or times out.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b  (Llama models are Enterprise-only on Groq now)

GOOGLE_GENERATIVE_AI_API_KEY=
# GOOGLE_MODEL=gemini-3.5-flash-lite  (gemini-2.0-flash is shut down)

# Optional. Without this, plans live in server memory + browser localStorage.
# JSON files are not used: they do not persist on Vercel serverless.
POSTGRES_URL=

# v2 enrichment. Set to 1 to make every data source read
# fixtures/api/<source>/*.json instead of calling live APIs (offline demo/tests).
# Local/dev only: fixture files are not bundled into Vercel functions.
ADPILOT_MOCK_APIS=

# F1 part B: PageSpeed Insights v5 (mobile speed, checked after the plan renders).
# Google Cloud > enable "PageSpeed Insights API" > API key restricted to that API.
PAGESPEED_API_KEY=

# F2: Google Places API (New), Text Search (local competitors + "are you on Maps?").
# Needs billing on the Cloud project. Restrict the key to Places API (New) and set a
# daily quota + budget alert. Rating fields put competitor search on the Enterprise SKU.
GOOGLE_PLACES_API_KEY=

# F5: YouTube Data API v3 (local creator finder). Same Cloud project > enable
# "YouTube Data API v3" > key restricted to it. Free: 10,000 units/day; one plan
# costs 101 units (search.list 100 + channels.list 1), cached 7 days.
YOUTUBE_API_KEY=

# F4: Meta audience size (Marketing API reachestimate). Server-side system-user
# token with ads_read; no user OAuth, no spend. All three are needed; without them
# the "Who you can reach" chapter says Not connected. Verify with:
#   npm run record -- meta
META_ACCESS_TOKEN=
# Ad account id, with or without the act_ prefix.
META_AD_ACCOUNT_ID=
# Pinned Graph/Marketing API version, e.g. v26.0 (latest as of Jul 2026).
META_API_VERSION=
